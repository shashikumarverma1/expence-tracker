rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photo (see src/features/profile/hook/useProfile.ts) — owner
    // reads/writes their own avatar only.
    match /avatars/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Voice-entry recordings (see ConfirmTransactionScreen.tsx) — owner
    // reads/writes their own recordings only.
    match /voiceRecordings/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else: denied by default (no bucket-wide catch-all) — add a
    // scoped match block above for any new upload path instead of opening
    // this up broadly.
  }
}
