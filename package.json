    "@react-navigation/drawer": "^7.9.11",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.14.14",
    "@react-navigation/stack": "^7.8.13",
    "add": "^2.0.6",
    "expo": "~56.0.9",
    "expo-audio": "^56.0.11",
    "expo-build-properties": "~56.0.17",
    "expo-constants": "~56.0.17",
    "expo-dev-client": "~56.0.19",
    "expo-file-system": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-modules-core": "~56.0.15",
    "expo-notifications": "~56.0.16",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "firebase": "^12.13.0",
    "formik": "^2.4.9",
